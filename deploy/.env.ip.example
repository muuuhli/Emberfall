# Public template only. Keep the real .env.ip outside the repository.
# For a server release, replace local with the full tested Git commit SHA.
EMBERFALL_RELEASE=local
# Verify that the chosen TCP port is unused before starting.
EMBERFALL_PUBLIC_PORT=8088
EMBERFALL_MAX_ROOMS=8
# Limits keep the new game service within a separate resource budget.
EMBERFALL_MEMORY_LIMIT=768m
EMBERFALL_CPU_LIMIT=0.5
# Empty: the game and API share http://<server-ip>:<port>.
# A separate existing Sites frontend requires its exact HTTPS origin here.
EMBERFALL_ALLOWED_ORIGIN=
